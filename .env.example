# ---------------------------------------------------------------------------
# Supabase
# Project settings -> API
#
# Preferred names are NEXT_PUBLIC_*. VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# and SUPABASE_URL / SUPABASE_ANON_KEY are also read, so an older Vite-style
# Vercel project keeps working.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser.
#
# Needed for automatic payments (Razorpay / Stripe webhooks have no user
# session). Collecting by UPI only does not use it.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts freelancer Razorpay/Stripe secrets at rest. Generate any long random
# string (e.g. `openssl rand -hex 32`) and never commit it.
PAYMENT_SECRETS_KEY=

# ---------------------------------------------------------------------------
# App
# Public origin for the client portal, webhooks, and Open Graph images.
# Local: http://localhost:3000
# Production: https://www.paymeify.com
# On Vercel production, localhost and *.vercel.app values are ignored so
# SEO, OG, and Google sign-in always use https://www.paymeify.com.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Client notifications (email + SMS)
# Optional. Without these keys, projects still save — the client just is not
# emailed or texted. Resend: https://resend.com  MSG91: https://msg91.com
# Verify paymeify.com on Resend, then set RESEND_FROM to that address.
# MSG91: Authkey from the dashboard. Sender ID is 6 letters (DLT-approved).
# For India delivery, also create an SMS Flow and set MSG91_TEMPLATE_ID.
# Template variables: name, project, link, extra, token
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Paymeify <hello@paymeify.com>
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# Cron auth for payment reminders + reconcile (Vercel sends this as Bearer).
CRON_SECRET=
