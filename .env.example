# ---------------------------------------------------------------------------
# Supabase
# Project settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser.
#
# Only needed for Razorpay, whose webhook arrives with no user session to act on
# behalf of. Collecting by UPI does not use it, so you can leave this blank.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Razorpay — optional
#
# Needs a registered business and KYC. Without it the app still collects money:
# add a UPI ID in Settings and clients pay by scanning a QR. The difference is
# that Razorpay confirms payments automatically, while UPI transfers are
# confirmed by you once you see them in your bank.
#
# Dashboard -> Account & Settings -> API Keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Dashboard -> Webhooks. Subscribe to:
#   payment_link.paid, payment_link.partially_paid,
#   payment_link.expired, payment_link.cancelled
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---------------------------------------------------------------------------
# App
# Public origin, used to build client portal + payment callback URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
